      "text": "offer(e) => Ajoute un élément en fin de file\npooll() => retire et retourne le premier élément\npeek() => Regarde le premier élément sans le retirer",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "offer(e) => Ajoute un élément en fin de file\npooll() => retire et retourne le premier élément\npeek() => Regarde le premier élément sans le retirer",
      "autoResize": true,
      "lineHeight": 1.25
