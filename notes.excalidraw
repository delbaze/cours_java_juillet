      "updated": 1785156184182,
      "link": null,
      "locked": false,
      "text": "public class Voiture extends Vehicule {\n        private int nbPortes;\n\n        public Voiture(String modele, int nbPortes) {\n            super(modele);\n            this.nbPortes = nbPortes;\n        }\n\n        @Override\n        public Voiture dupliquer() {\n            return new Voiture(modele, nbPortes)\n        }\n\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "public class Voiture extends Vehicule {\n        private int nbPortes;\n\n        public Voiture(String modele, int nbPortes) {\n            super(modele);\n            this.nbPortes = nbPortes;\n        }\n\n        @Override\n        public Voiture dupliquer() {\n            return new Voiture(modele, nbPortes)\n        }\n\n}",
      "autoResize": true,
      "lineHeight": 1.25
