      "updated": 1785140496805,
      "link": null,
      "locked": false,
      "text": "C1 (client compiler) => rapide, mais peu optimisé \nC2 (server compiler)  => plus lent à compiler mais produisant un code machine très optimisé\ntiered compilation (compilation à plusieurs niveaux)",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C1 (client compiler) => rapide, mais peu optimisé \nC2 (server compiler)  => plus lent à compiler mais produisant un code machine très optimisé\ntiered compilation (compilation à plusieurs niveaux)",
      "autoResize": true,
      "lineHeight": 1.25
    },
