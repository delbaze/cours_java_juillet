      "boundElements": [],
      "updated": 1785315647514,
      "link": null,
      "locked": false,
      "text": "public final class LivraisonStandard extends Livraison {\n    public LivraisonStandard(double poidsKg) {\n        super(poidsKg);\n    }\n\n    @Override\n       public double calculerFrais() {\n            return poidsKg * 0.5;\n        }\n}",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "public final class LivraisonStandard extends Livraison {\n    public LivraisonStandard(double poidsKg) {\n        super(poidsKg);\n    }\n\n    @Override\n       public double calculerFrais() {\n            return poidsKg * 0.5;\n        }\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
