      "updated": 1785315493202,
      "link": null,
      "locked": false,
      "text": "String traiter(MoyenPaiement moyen) {\n    return switch (moyen) {\n        case CarteBancaire c -> \"Paiement par carte \" + c.numero();\n        case Virement v -> \"Virement depuis + \" v.iban();\n        case Cheque v -> \"Cheque N°  + \" c.numero();\n        ...\n\n}",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
