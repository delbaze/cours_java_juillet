      "text": "Une classe \"porteuse de données\" (DTO) demande \nénormément de code répétitif pour un contenu\nqui n'apporte aucune information métier",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Une classe \"porteuse de données\" (DTO) demande \nénormément de code répétitif pour un contenu\nqui n'apporte aucune information métier",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "9Q1bAXdk8QqOGGVe8UXU3",
      "type": "text",
      "x": 1347.6520858349231,
      "y": 18313.477107006398,
      "width": 459.29998779296875,
      "height": 680,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#eebefa",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b05",
      "roundness": null,
      "seed": 1664553102,
      "version": 884,
      "versionNonce": 548249810,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785311850286,
      "link": null,
      "locked": false,
      "text": "public final class Produit {\n        private final String nom;\n        private final double prix;\n        private final int stock;\n\n        public Produit(String nom, double prix, int stock) {\n            this.nom = nom;\n            ....\n        }\n\n        public String getNom() { return nom;};\n        ...\n \n\n   @Override\n    public boolean equals(Object o) {\n        if (this == o) return true;\n        if (!(o instanceof Produit)) return false;\n        Produit produit = (Produit) o;\n\n        return Double.compare(produit.prix, prix) == 0 && \n        stock == produit.stock\n        && Objects.equals(nom, produit.nom);\n    }\n\n    @Override\n    public int hashCode() { return Objects.hash(nom, prix, stock);}\n\n    @Override\n    public String toString() {\n        return \"Produit[nom='\" + nom + \"', prix=.....]\"\n    }\n\n}",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "public final class Produit {\n        private final String nom;\n        private final double prix;\n        private final int stock;\n\n        public Produit(String nom, double prix, int stock) {\n            this.nom = nom;\n            ....\n        }\n\n        public String getNom() { return nom;};\n        ...\n \n\n   @Override\n    public boolean equals(Object o) {\n        if (this == o) return true;\n        if (!(o instanceof Produit)) return false;\n        Produit produit = (Produit) o;\n\n        return Double.compare(produit.prix, prix) == 0 && \n        stock == produit.stock\n        && Objects.equals(nom, produit.nom);\n    }\n\n    @Override\n    public int hashCode() { return Objects.hash(nom, prix, stock);}\n\n    @Override\n    public String toString() {\n        return \"Produit[nom='\" + nom + \"', prix=.....]\"\n    }\n\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
